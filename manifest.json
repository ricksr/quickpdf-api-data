      "mime": "application/json"
    },
    {
      "name": "rate-limits",
      "path": "rate-limits.json",
      "mime": "application/json"
    },
    {
      "name": "postman",
      "path": "postman-collection.json",
      "mime": "application/json"
    },
    {
      "name": "readme",
      "path": "README.md",
      "mime": "text/markdown"
    }
